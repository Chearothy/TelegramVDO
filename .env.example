# Telegram channel username without @
TELEGRAM_CHANNEL_USERNAME=rothy_video_library

# Optional: leave blank to use Telegram public preview mode (limited to small videos).
# For full-size streaming, set all three values using a Telegram user session.
TG_API_ID=
TG_API_HASH=
TG_SESSION=

# Server settings
PORT=3000
ALLOWED_ORIGIN=https://telegram-vdo.vercel.app
REFRESH_MINUTES=3
FULL_SCAN_HOURS=6
MAX_PAGES=200
PAGE_DELAY_MS=400
